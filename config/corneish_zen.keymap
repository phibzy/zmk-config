#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

// Mae sure order of these matches order of layers below, otherwise numbering will be cooked
// TODO: F keys, media keys, etc
// TODO: &lt on enter key

#define DEFAULT 0
#define NAV 1
#define SYMNO 2

/ {
    chosen {
        zmk,matrix_transform = &default_transform;

        // zmk,matrix_transform = &five_column_transform;
    };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "QWERTY";

            // --------------------------------------------------------------------------------
            // | TAB/ESC |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL    |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT    |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  |  `   |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&mt GRAVE ESC  &kp Q  &kp W  &kp E     &kp R  &kp T      &kp Y      &kp U  &kp I      &lt 4 O  &kp P                       &kp BSPC
&mt LCTRL TAB  &kp A  &kp S  &kp D     &kp F  &lt 5 G    &kp H      &kp J  &kp K      &kp L    &mt SINGLE_QUOTE SEMICOLON  &kp ENTER
&kp LSHFT      &kp Z  &kp X  &kp C     &kp V  &kp B      &kp N      &kp M  &kp COMMA  &kp DOT  &kp FSLH                    &kp DELETE
                             &kp LGUI  &mo 1  &tog 3     &kp SPACE  &mo 2  &kp RALT
            >;
        };

        symno_layer {
            label = "SYMNO";

            // -----------------------------------------------------------------------------------------
            // | TAB/ESC |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | CTRL    |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  ~   |
            // | SHFT    |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  `   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&trans  &kp N1     &kp N2  &kp N3  &kp N4  &kp N5    &kp N6     &kp N7     &kp N8    &kp N9    &kp N0    &trans
&trans  &kp GRAVE  &trans  &trans  &trans  &trans    &kp MINUS  &kp EQUAL  &kp LBKT  &kp RBKT  &kp BSLH  &trans
&trans  &kp TILDE  &trans  &trans  &trans  &trans    &kp UNDER  &kp PLUS   &kp LBRC  &kp RBRC  &kp PIPE  &trans
                           &trans  &trans  &none     &trans     &trans     &trans
            >;
        };

        nav_layer {
            label = "NAV";

            // -----------------------------------------------------------------------------------------
            // | TAB/ESC |  1  |  2  |  3  |  4  |  5  |   |  6  | PG_DWN |  PG_UP  |  9  |  0  | BKSP |
            // | BTCLR   | BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN    |  UP     | RGT |     |      |
            // | SHFT    |     |     |     |     |     |   |     |        |         |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&trans  &none   &none   &none   &none   &none     &none     &none          &none          &none      &none   &kp BSPC
&trans  &trans  &trans  &trans  &trans  &trans    &kp LEFT  &kp DOWN       &kp UP         &kp RIGHT  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans    &kp PAGE_DOWN  &kp PAGE_DOWN  &trans     &trans  &trans
                        &trans  &trans  &none     &trans    &none          &trans
            >;
        };

        fkeys_layer {
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6    &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans   &trans   &trans
                        &trans  &trans  &tog 3    &trans  &trans  &trans
            >;

            label = "FKEYS";
        };

        bluetooth {
            label = "BLUETOOTH";
            bindings = <
&none       &none         &none         &none         &none         &none           &none  &none  &none  &none  &none  &none
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &none  &none  &none  &none  &none  &none
&none       &none         &none         &none         &none         &none           &none  &none  &none  &none  &none  &none
                                        &none         &none         &none           &none  &none  &none
            >;
        };

        media {
            bindings = <
&none  &none  &none       &kp C_BRI_DEC  &kp C_BRI_INC  &none    &none    &none            &none         &none       &none  &none
&none  &none  &kp C_PREV  &kp C_PAUSE    &kp C_NEXT     &none    &kp F20  &kp C_VOL_DN     &kp C_VOL_UP  &kp C_MUTE  &none  &none
&none  &none  &none       &none          &none          &none    &none    &none            &none         &none       &none  &none
                          &none          &none          &none    &none    &kp PRINTSCREEN  &none
            >;

            label = "MEDIA";
        };
    };
};
